# ---- Identity (the product name is not final: never hard-code it) ----
NEXT_PUBLIC_APP_NAME="HotelOS"
NEXT_PUBLIC_APP_DOMAIN="hotelos.ng"
NEXT_PUBLIC_SUPPORT_EMAIL="support@hotelos.ng"

# ---- Where things live ----
# The platform API. The browser never calls it directly: the console's own
# /api/* route handlers forward to it from the server.
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Hotel admin (impersonation sessions open here) and the guest web app.
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# development | staging | production -- shown as a chip in the top bar.
NEXT_PUBLIC_CONSOLE_ENV="development"

# ---- Server-only (never NEXT_PUBLIC_) ----
# Private address of the API when the console server reaches it over an
# internal network (defaults to NEXT_PUBLIC_API_URL).
API_INTERNAL_URL=""
# Same value as the API's TRUSTED_PROXY_SECRET: lets the API trust the
# X-Client-IP this server forwards (IP allowlists, lockouts, rate limits).
TRUSTED_PROXY_SECRET="dev-trusted-proxy-secret"
# Optional shared key sent as X-Platform-Proxy-Key so the API can accept
# platform calls only from this server.
PLATFORM_PROXY_KEY=""

# ---- Development conveniences (ignored by production builds) ----
NEXT_PUBLIC_DEV_LOGIN_EMAIL="admin@devstrike.ng"
NEXT_PUBLIC_DEV_LOGIN_PASSWORD="Admin1234!"
# The seeded dev TOTP secret for admin@devstrike.ng (see the API README).
NEXT_PUBLIC_DEV_TOTP_SECRET=""
